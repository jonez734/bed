[Unit]
Description=BED - BBS Engine Daemon
Documentation=https://bbsengine.org/
After=network.target postgresql.service oidentd.service
Wants=postgresql.service
Requires=oidentd.service
# Cap any unclassified crash loop at 10 attempts per 5 minutes so the
# operator notices the failure (unit enters 'failed' state) instead
# of the daemon quietly retrying forever.
StartLimitIntervalSec=300s
StartLimitBurst=10

[Service]
Type=simple
User=bed
Group=bed
WorkingDirectory=/var/lib/bed

# The packaged configuration is used (no --config, no environment file).
# The database login is decided by the identd map for this OS user.
ExecStart=@VENV_DIR@/bin/bed

ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=5s

# bed exits 2 on permanent bind failures (EADDRINUSE/EACCES) when
# restart_on_bind_failure=false, and exits 3 when a transient FS /
# network error prevents loading the explicit config file with
# autorestart off (see bed.config.ConfigIORecoverableError). Do not
# loop the unit on either case.
RestartPreventExitStatus=2 3

KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bed

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/bed /var/lib/bed

[Install]
WantedBy=multi-user.target
