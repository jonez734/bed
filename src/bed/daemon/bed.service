[Unit]
Description=BED - BBS Engine Daemon
Documentation=https://bbsengine.org/
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=bed
Group=bed
WorkingDirectory=/var/lib/bed

EnvironmentFile=-/etc/bed/bed.env

ExecStart=@VENV_DIR@/bin/bed --config /etc/bed/bed.json

ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=5s

KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bed

[Install]
WantedBy=multi-user.target
